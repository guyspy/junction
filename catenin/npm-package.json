{
  "name": "@junction/catenin",
  "version": "1.0.0",
  "description": "Kotlin Multiplatform game engine for creating 2D card-based educational games",
  "main": "junction-catenin.mjs",
  "types": "junction-catenin.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./junction-catenin.d.ts",
      "import": "./junction-catenin.mjs",
      "default": "./junction-catenin.mjs"
    }
  },
  "files": [
    "junction-catenin.mjs",
    "junction-catenin.d.ts",
    "junction-catenin.mjs.map",
    "*.mjs",
    "*.d.ts",
    "*.mjs.map"
  ],
  "keywords": [
    "game-engine",
    "kotlin-multiplatform",
    "educational-games",
    "card-games",
    "javascript",
    "typescript",
    "yaml",
    "ai-friendly"
  ],
  "author": "Junction Team",
  "license": "MIT",
  "homepage": "https://github.com/junction/catenin",
  "repository": {
    "type": "git",
    "url": "https://github.com/junction/catenin"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}