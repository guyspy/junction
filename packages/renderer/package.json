{
  "name": "@junction/renderer",
  "version": "0.0.1-alpha.0",
  "description": "Cadherin — Junction's accessible DOM renderer: GameSpec + projection → playable HTML.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standalone.js": "./dist/standalone.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/build-standalone.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@junction/runtime": "workspace:*",
    "@junction/spec": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
