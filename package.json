{
  "name": "junction-monorepo",
  "private": true,
  "version": "0.0.1-alpha.0",
  "description": "Agent-native game engine + studio for 2D educational card/board/adventure/RPG games.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc -b packages/spec packages/runtime packages/mcp packages/cli",
    "test": "pnpm -r --filter '@junction/*' test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm run check:boundaries && pnpm run build && pnpm run test",
    "junction": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.12.1"
}
